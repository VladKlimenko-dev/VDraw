<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <StartupObject>VDraw.Program</StartupObject>
    <ApplicationIcon>Resources\vdraw.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.151.1" />
  </ItemGroup>

  <!--
    Avalonia — слой интерфейса для новых панелей (папка Avalon). Окон у неё
    своих нет: контролы вставляются в WinForms через
    WinFormsAvaloniaControlHost из пакета Avalonia.Win32.Interoperability.

    Все четыре пакета обязаны быть одной версии: при расхождении NuGet
    подтянет разные сборки Avalonia, и тема Fluent окажется собрана против
    другого ядра.

    Avalonia.Desktop нужен ради UsePlatformDetect() в AvBootstrap —
    без него приложению неизвестно, каким бэкендом рисовать.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Win32.Interoperability" Version="12.1.4" />
  </ItemGroup>

  <!--
    Иконочный шрифт нужен Avalonia как ресурс сборки: шрифт с диска по пути
    она не открывает. Файл при этом остаётся и в Resources для WinForms —
    тот слой читает его именно оттуда (MainForm.SetIcons), поэтому запись
    ниже добавляет второй экземпляр внутрь сборки, а не переносит файл.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Resources\FluentSystemIcons-Resizable.ttf" />
  </ItemGroup>

  <!--
    Единое правило копирования вместо пятидесяти отдельных записей <None Update>.
    Любой новый файл, положенный в Resources (включая вложенные папки Patterns,
    Textures, Brushes, Icons), попадает в каталог сборки автоматически —
    csproj больше править не нужно.

    Каталог назначения повторяет структуру Resources, поэтому в рантайме путь
    строится как ResourcePaths.Patterns / ResourcePaths.Textures и т.д.

    Исключены .resx: они компилируются как EmbeddedResource и в выходной
    каталог попадать не должны.
  -->
  <ItemGroup>
    <None Include="Resources\**\*" Exclude="Resources\**\*.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\vdraw.ico" />
  </ItemGroup>

  <!--
    Нативные библиотеки. Правило то же, что и для Resources: любой файл,
    положенный в Libraries, попадает в каталог сборки с сохранением
    структуры подпапок. Туда кладётся pdfium.dll — её ищет
    PdfImporter.InstallResolver, начиная именно с этой папки.
  -->
  <ItemGroup>
    <None Include="Libraries\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libraries\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>